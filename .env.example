# StreamGuard environment — copy to .env and fill in.
# `make data` needs a free Kaggle account: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Kafka (host-side processes talk to the mapped port)
KAFKA_BOOTSTRAP=localhost:9092

# Redis
REDIS_URL=redis://localhost:6379/0

# Replay pacing (see PLAN.md §7)
REPLAY_RATE_TX_PER_SEC=200
TIME_COMPRESSION=8800
REPLAY_LIMIT=0                # 0 = full 590,540 rows; set small for smoke tests

# MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MODEL_NAME=streamguard-scorer

# Scorer thresholds (recomputed by M5; these are initial values)
FPR_LIMIT=0.05
